{
  "manifest_version": 3,
  "name": "ResistGate",
  "version": "1.0.0",
  "description": "Block distracting sites. Unlock them only when you've earned it. ResistGate builds real discipline, one challenge at a time.",
  "icons": {
    "16": "icons/16x16.png",
    "32": "icons/32x32.png",
    "48": "icons/48x48.png",
    "128": "icons/128x128.png"
  },
  "permissions": [
    "declarativeNetRequest",
    "storage",
    "alarms"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "ResistGate"
  },
  "options_page": "options/options.html",
  "web_accessible_resources": [
    {
      "resources": ["welcome/welcome.html"],
      "matches": ["<all_urls>"]
    }
  ],
  "externally_connectable": {
    "matches": [
      "http://localhost:3000/*",
      "https://www.orlandoascanio.com/*",
      "https://orlandoascanio.com/*"
    ]
  },
  "host_permissions": [
    "<all_urls>"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src https://*.ingest.sentry.io https://*.ingest.us.sentry.io"
  }
}
